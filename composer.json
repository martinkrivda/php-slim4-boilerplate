{
  "name": "php-db-boilerplate/app",
  "description": "Slim 4 boilerplate with Nginx + PHP-FPM.",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "monolog/monolog": "^3.10",
    "php-di/php-di": "^7.1",
    "phpmailer/phpmailer": "^7.0.1",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15",
    "slim/twig-view": "^3.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3",
    "squizlabs/php_codesniffer": "^4.0.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "phpcs": "phpcs",
    "test": "phpunit"
  }
}
